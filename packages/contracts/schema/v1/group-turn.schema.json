{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.cupcakeagi.local/v1/group-turn.schema.json",
  "additionalProperties": false,
  "type": "object",
  "required": [
    "turnId",
    "conversationId",
    "branchId",
    "userMessageId",
    "status",
    "mode",
    "digest",
    "planRevision",
    "rosterRevision",
    "maxReplies",
    "maxSelectorCalls",
    "selectorCalls",
    "responderCalls",
    "selectorUsage",
    "plan",
    "createdAt",
    "updatedAt",
    "completedAt",
    "members"
  ],
  "properties": {
    "turnId": {
      "description": "Lowercase RFC 9562 UUID version 7.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "conversationId": {
      "description": "Lowercase RFC 9562 UUID version 7.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "branchId": {
      "description": "Lowercase RFC 9562 UUID version 7.",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
      "type": "string"
    },
    "userMessageId": {
      "description": "Lowercase RFC 9562 UUID version 7.",
