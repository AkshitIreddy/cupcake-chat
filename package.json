{
  "name": "cupcakeagi",
  "version": "1.8.1",
  "private": true,
  "description": "Cupcake Chat local desktop workspace",
  "license": "MIT",
  "packageManager": "pnpm@10.15.1",
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "corepack pnpm -r build",
    "check": "corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:sidecars": "node scripts/test-sidecar-protocol.mjs",
    "test:watch": "vitest",
    "typecheck": "corepack pnpm -r typecheck",
    "clean:preview": "node scripts/clean-workspace.mjs",
    "clean:generated": "node scripts/clean-workspace.mjs --apply",
    "clean:profiles": "node scripts/clean-workspace.mjs --apply --profiles",
    "test:workspace": "node --test scripts/test-workspace.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
