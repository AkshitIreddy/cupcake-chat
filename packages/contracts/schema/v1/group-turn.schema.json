        },
        {
          "const": "completed",
          "type": "string"
        },
        {
          "const": "waiting_for_you",
          "type": "string"
        },
        {
          "const": "selection_failed",
          "type": "string"
        },
        {
          "const": "member_failed",
          "type": "string"
        },
        {
          "const": "cancelled",
          "type": "string"
        },
        {
          "const": "awaiting_tool",
          "type": "string"
        },
        {
          "const": "interrupted",
