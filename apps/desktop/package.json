{
  "name": "@cupcakeagi/desktop",
  "version": "2.0.0-rc.1",
  "description": "CupcakeAI 2.0 desktop application",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "node ../../node_modules/vite/bin/vite.js --config vite.renderer.config.ts",
    "build": "pnpm run build:web",
    "build:web": "node ../../node_modules/vite/bin/vite.js build --config vite.renderer.config.ts",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build --no-bundle",
    "bundle:nsis": "tauri build --bundles nsis",
    "test": "node ../../node_modules/vitest/vitest.mjs run --config vitest.config.mts",
    "test:watch": "node ../../node_modules/vitest/vitest.mjs --config vitest.config.mts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "katex": "^0.18.4",
    "lucide-react": "^1.35.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
