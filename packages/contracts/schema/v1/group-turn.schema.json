                  },
                  "reason": {
                    "maxLength": 120,
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "usage": {
            "type": "object",
            "patternProperties": {
              "^(.*)$": {
                "$id": "T0",
                "anyOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "string"
                  },
                  {
                    "type": "array",
                    "items": {
                      "$ref": "T0"
                    }
                  },
                  {
                    "type": "object",
                    "patternProperties": {
                      "^(.*)$": {
                        "$ref": "T0"
                      }
                    }
                  }
                ]
              }
            }
          },
