{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Narrow local-only permissions for the CupcakeAI main workbench.",
  "local": true,
  "windows": ["main"],
  "platforms": ["windows"],
  "permissions": [
    "core:event:default",
    "allow-app-info",
    "allow-app-quit",
    "allow-app-update-check",
    "allow-app-update-download",
    "allow-app-update-install",
    "allow-app-update-status",
    "allow-command-execute",
    "allow-dialog-choose-save-target",
    "allow-dialog-open-directory",
    "allow-dialog-open-files",
    "allow-dialog-release-handle",
    "allow-open-external-url",
    "allow-provider-connect",
    "allow-provider-disconnect",
    "allow-provider-test",
    "allow-runtime-cancel",
    "allow-runtime-request",
    "allow-runtime-status",
    "allow-window-close",
    "allow-window-close-response",
    "allow-window-is-maximized",
    "allow-window-minimize",
    "allow-window-preferences-get",
    "allow-window-preferences-set",
    "allow-window-start-dragging",
    "allow-window-toggle-maximize",
    "allow-workspace-lock",
    "allow-workspace-lock-status",
    "allow-workspace-password-change",
    "allow-workspace-password-setup",
    "allow-workspace-protection-disable",
    "allow-workspace-unlock"
  ]
}
